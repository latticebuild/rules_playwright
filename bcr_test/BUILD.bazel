load("@io_bazel_rules_go//go:def.bzl", "go_test")
load(":inventory.bzl", "browser_inventory")

exports_files([
    "browsers.json",
    "go.mod",
    "go.sum",
])

browser_inventory(
    name = "inventory",
    testonly = True,
    browser = "@browser_payload//:chromium",
)

go_test(
    name = "test",
    srcs = ["browser_test.go"],
    data = [
        "index.html",
        ":inventory",
        "@browser_payload//:chromium",
    ],
    env = {
        "BROWSER_INVENTORY": "$(rlocationpath :inventory)",
        "BROWSER_PAGE": "$(rlocationpath index.html)",
    },
    tags = ["no-sandbox"],
    deps = [
        "@com_github_latticebuild_graceproc//:graceproc",
        "@io_bazel_rules_go//go/runfiles",
    ],
)

filegroup(
    name = "artifacts",
    testonly = True,
    srcs = [
        ":test",
        "@browser_payload//:chromium",
    ],
)
